from typing import List

class Solution:
    def minSwaps(self, nums: List[int]) -> int:
        def digit_sum(x: int) -> int:
            s = 0
            while x > 0:
                s += x % 10
                x //= 10
            return s
        
        n = len(nums)
        # Sort based on digit sum, then by value
        target = sorted(nums, key=lambda x: (digit_sum(x), x))
        
        # Map each value to its correct index in the sorted array
        val_to_idx = {val: i for i, val in enumerate(target)}
        
        visited = [False] * n
        swaps = 0
        
        for i in range(n):
            if visited[i] or val_to_idx[nums[i]] == i:
                continue
            
            # Traverse the cycle
            cycle_size = 0
            curr = i
            while not visited[curr]:
                visited[curr] = True
                curr = val_to_idx[nums[curr]]
                cycle_size += 1
            
            if cycle_size > 1:
                swaps += (cycle_size - 1)
                
        return swaps    
